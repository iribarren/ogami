{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogami.app/contracts/gamesystem-release/v2.schema.json",
  "title": "GameSystem release, schema version 2",
  "description": "The Published Language between Studio and Play: the content of one immutable GameSystem release with trackers, fact slots, Scene Types and NarrativeFlows (ADR 0017, ADR 0018). This schema encodes the structural rules only. Semantic rules are enforced by the Studio domain and are not expressible here: every rule of schema version 1, unique keys (trackers, fact slots, tags, Scene Types, flows, phases, steps, choice options, table entries, table branches), unique and existing tags in picks, counts and effects, pick counts with min at most max, forward-only \"next\", band ordering, references to trackers, Scene Types, oracles, levels and entries, the trackers and oracles each flow may use, at most one default flow, counter and chaos tracker ranges, suggested choices naming \"skip\", oracle-selection tables, dice notation, placeholders and trimmed lengths. Optional fields may be omitted or null. See docs/contracts/gamesystem-release.md.",
  "type": "object",
  "required": ["schemaVersion", "gameSystem", "oracles", "trackers", "factSlots", "sceneTypes", "flows", "sheet", "checks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "description": "Version of this contract. Not the release version, which Studio assigns when publishing.",
      "const": 2
    },
    "gameSystem": { "$ref": "#/$defs/gameSystem" },
    "theme": {
      "description": "The curated Theme Play applies inside a Campaign pinned to this release. Optional; omitted or null means the default app theme.",
      "enum": ["parchment", "neon", "noir", "eldritch", "starship", null]
    },
    "oracles": { "$ref": "#/$defs/oracles" },
    "trackers": {
      "description": "Counters and clocks a Campaign holds a value for. May be empty.",
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/tracker" }
    },
    "factSlots": {
      "description": "Slots a Campaign fills with facts: a text, an NPC or a Thread. Flows fill them with the fillFact effect. May be empty.",
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/factSlot" }
    },
    "tags": {
      "description": "Tags NPCs and Threads carry, picked and counted by key. Optional; may be empty.",
      "type": ["array", "null"],
      "maxItems": 50,
      "items": { "$ref": "#/$defs/tag" }
    },
    "sceneTypes": {
      "description": "Release-level Scene Types the flows select. May be empty.",
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/sceneType" }
    },
    "flows": {
      "description": "NarrativeFlows. May be empty: the GameSystem is then played freely.",
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/flow" }
    },
    "sheet": {
      "description": "The character sheet template (ADR 0022). {} and {\"fields\": []} are the same sheet: no fields. Field keys are unique (checked by the domain).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": ["array", "null"],
          "maxItems": 100,
          "items": { "$ref": "#/$defs/sheetField" }
        }
      }
    },
    "checks": {
      "description": "Reserved; must be empty in schema version 2.",
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "key": {
      "description": "Lowercase identifier: a-z, 0-9 and \"-\", 1 to 64 characters.",
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "optionalKey": {
      "anyOf": [{ "$ref": "#/$defs/key" }, { "type": "null" }]
    },
    "uniqueKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 100 },
    "sheetField": {
      "description": "One field of the sheet, by its type.",
      "oneOf": [
        { "$ref": "#/$defs/numberField" },
        { "$ref": "#/$defs/textField" },
        { "$ref": "#/$defs/listField" },
        { "$ref": "#/$defs/trackField" }
      ]
    },
    "numberField": {
      "description": "A bounded integer. min <= default <= max (checked by the domain).",
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/label" },
        "hint": { "type": ["string", "null"], "maxLength": 500 },
        "group": { "type": ["string", "null"], "minLength": 1, "maxLength": 60 },
        "type": { "const": "number" },
        "min": { "$ref": "#/$defs/sheetNumber" },
        "max": { "$ref": "#/$defs/sheetNumber" },
        "default": { "$ref": "#/$defs/sheetNumber" }
      }
    },
    "sheetNumber": { "type": ["integer", "null"], "minimum": -1000000, "maximum": 1000000 },
    "textField": {
      "description": "Free text, 200 characters by default and 2000 when multiline.",
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/label" },
        "hint": { "type": ["string", "null"], "maxLength": 500 },
        "group": { "type": ["string", "null"], "minLength": 1, "maxLength": 60 },
        "type": { "const": "text" },
        "multiline": { "type": ["boolean", "null"] },
        "maxLength": { "type": ["integer", "null"], "minimum": 1, "maximum": 2000 }
      }
    },
    "listField": {
      "description": "A list of short texts, such as an inventory.",
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/label" },
        "hint": { "type": ["string", "null"], "maxLength": 500 },
        "group": { "type": ["string", "null"], "minLength": 1, "maxLength": 60 },
        "type": { "const": "list" },
        "itemLabel": { "type": ["string", "null"], "minLength": 1, "maxLength": 60 },
        "maxItems": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
      }
    },
    "trackField": {
      "description": "A resource track {current, max}, such as hit points. A fixed max when set, else each Character sets its own.",
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/label" },
        "hint": { "type": ["string", "null"], "maxLength": 500 },
        "group": { "type": ["string", "null"], "minLength": 1, "maxLength": 60 },
        "type": { "const": "track" },
        "max": { "type": ["integer", "null"], "minimum": 1, "maximum": 999 }
      }
    },
    "tag": {
      "type": "object",
      "required": ["key", "label"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1, "maxLength": 50 },
        "hint": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "tagKeys": {
      "description": "Tag keys of the release, unique; at most 5.",
      "type": ["array", "null"],
      "maxItems": 5,
      "items": { "$ref": "#/$defs/key" }
    },
    "optionalText2000": { "type": ["string", "null"], "maxLength": 2000 },
    "optionalFlag": { "type": ["boolean", "null"] },
    "trackerRef": {
      "description": "The current value of a tracker.",
      "type": "object",
      "required": ["tracker"],
      "additionalProperties": false,
      "properties": {
        "tracker": { "$ref": "#/$defs/key" }
      }
    },
    "gameSystem": {
      "type": "object",
      "required": ["key", "name"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": ["string", "null"], "maxLength": 2000 },
        "credits": { "$ref": "#/$defs/credits" }
      }
    },
    "credits": {
      "description": "The notice, license and link a release carries, such as a fan preset's publisher disclaimer (ADR 0021). Optional; omitted or null means no credits.",
      "type": ["object", "null"],
      "required": ["notice"],
      "additionalProperties": false,
      "properties": {
        "notice": { "description": "The text Play shows. Trimmed, 1 to 2000 characters.", "type": "string", "minLength": 1, "maxLength": 2000 },
        "license": { "description": "The name of the license or policy the content is provided under.", "type": ["string", "null"], "maxLength": 200 },
        "url": { "description": "Where the license or policy is published: an absolute https:// URL.", "type": ["string", "null"], "maxLength": 500, "pattern": "^https://[^\\s/?#]+\\S*$" }
      }
    },
    "oracles": {
      "type": "object",
      "required": ["tables", "likelihood"],
      "additionalProperties": false,
      "properties": {
        "tables": {
          "description": "One oracle table set (Randomness OracleTableSet). May be empty.",
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/oracleTable" }
        },
        "likelihood": {
          "description": "Likelihood oracles (Randomness LikelihoodOracle). May be empty.",
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/likelihoodOracle" }
        }
      }
    },
    "oracleTable": {
      "description": "A ranged table has \"dice\" and entries with \"min\" and \"max\"; a weighted table has no \"dice\" and entries with an optional \"weight\".",
      "type": "object",
      "required": ["key", "name", "entries"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "dice": { "description": "Dice notation, e.g. 1d6; ranged tables only.", "type": ["string", "null"] },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/oracleTableEntry" }
        }
      }
    },
    "oracleTableEntry": {
      "description": "An entry needs a non-empty \"text\" unless it nests a \"table\".",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": ["integer", "null"] },
        "max": { "type": ["integer", "null"] },
        "weight": { "type": ["integer", "null"], "minimum": 1 },
        "text": { "type": ["string", "null"], "maxLength": 500 },
        "table": {
          "description": "Key of a table of the same set to roll on next.",
          "$ref": "#/$defs/optionalKey"
        },
        "key": {
          "description": "Names the entry for table-step branches; unique within its table.",
          "$ref": "#/$defs/optionalKey"
        },
        "sceneType": {
          "description": "A Scene Type this entry offers or selects.",
          "$ref": "#/$defs/optionalKey"
        },
        "effects": {
          "description": "Applied when a flow step rolls the entry.",
          "$ref": "#/$defs/optionalEffects"
        }
      }
    },
    "likelihoodOracle": {
      "type": "object",
      "required": ["key", "name", "sides", "levels"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sides": { "type": "integer", "minimum": 2, "maximum": 1000 },
        "levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/likelihoodLevel" }
        },
        "chaos": {
          "anyOf": [{ "$ref": "#/$defs/likelihoodChaos" }, { "type": "null" }]
        },
        "exceptionalPercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 50 },
        "randomEvent": {
          "description": "A d100 roll that is a double (11, 22 ... 99) whose digit is at most the chaos factor used triggers a random event on the table. Needs chaos and sides 100; the table is one of oracles.tables.",
          "anyOf": [{ "$ref": "#/$defs/likelihoodRandomEvent" }, { "type": "null" }]
        }
      }
    },
    "likelihoodRandomEvent": {
      "type": "object",
      "required": ["table"],
      "additionalProperties": false,
      "properties": {
        "table": { "description": "Key of an oracle table of the release.", "$ref": "#/$defs/key" }
      }
    },
    "likelihoodLevel": {
      "type": "object",
      "required": ["key", "label", "target"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "minLength": 1, "maxLength": 500 },
        "target": { "description": "Highest roll that answers yes at the neutral chaos factor; 0..sides.", "type": "integer", "minimum": 0 }
      }
    },
    "likelihoodChaos": {
      "type": "object",
      "required": ["min", "max", "neutral", "shiftPerPoint"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": -1000 },
        "max": { "type": "integer", "maximum": 1000 },
        "neutral": { "type": "integer" },
        "shiftPerPoint": { "type": "integer", "minimum": 0 },
        "tracker": {
          "description": "A counter tracker whose min and max equal this chaos min and max; its value is the chaos factor.",
          "$ref": "#/$defs/optionalKey"
        }
      }
    },
    "tracker": {
      "oneOf": [{ "$ref": "#/$defs/counterTracker" }, { "$ref": "#/$defs/clockTracker" }]
    },
    "counterTracker": {
      "type": "object",
      "required": ["key", "name", "kind", "min", "max", "initial"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "$ref": "#/$defs/label" },
        "hint": { "type": ["string", "null"], "maxLength": 500 },
        "kind": { "const": "counter" },
        "min": { "type": "integer", "minimum": -1000, "maximum": 1000 },
        "max": { "type": "integer", "minimum": -1000, "maximum": 1000 },
        "initial": { "description": "min <= initial <= max.", "type": "integer", "minimum": -1000, "maximum": 1000 },
        "levels": {
          "description": "Named ranges of the value, ordered like outcome bands with literal upTo only.",
          "type": ["array", "null"],
          "maxItems": 20,
          "items": { "$ref": "#/$defs/counterLevel" }
        }
      }
    },
    "clockTracker": {
      "type": "object",
      "required": ["key", "name", "kind", "segments"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "$ref": "#/$defs/label" },
        "hint": { "type": ["string", "null"], "maxLength": 500 },
        "kind": { "const": "clock" },
        "segments": { "description": "A clock starts at 0 and fills up to segments.", "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "counterLevel": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "upTo": { "type": ["integer", "null"] },
        "label": { "$ref": "#/$defs/label" }
      }
    },
    "factSlot": {
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/label" },
        "type": { "enum": ["text", "npc", "thread"] },
        "hint": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "sceneType": {
      "type": "object",
      "required": ["key", "name", "purpose", "oracles", "setup", "play", "closing"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "$ref": "#/$defs/label" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "tips": { "$ref": "#/$defs/optionalText2000" },
        "oracles": {
          "description": "Oracle shortcuts of this Scene Type: keys of oracle tables or likelihood oracles.",
          "$ref": "#/$defs/uniqueKeys",
          "maxItems": 70
        },
        "setup": { "$ref": "#/$defs/steps" },
        "play": { "$ref": "#/$defs/steps" },
        "closing": { "$ref": "#/$defs/steps" }
      }
    },
    "flow": {
      "type": "object",
      "required": ["key", "name", "defaultView", "oracles", "trackers", "phases"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/optionalText2000" },
        "introduction": { "type": ["string", "null"], "maxLength": 5000 },
        "default": { "$ref": "#/$defs/optionalFlag" },
        "defaultView": { "enum": ["focus", "journal"] },
        "oracles": {
          "description": "Oracles the flow shows; every reachable Scene Type's oracles are among them.",
          "$ref": "#/$defs/uniqueKeys",
          "maxItems": 70
        },
        "trackers": {
          "description": "Trackers the flow shows and uses; every tracker reference the flow reaches is among them.",
          "$ref": "#/$defs/uniqueKeys",
          "maxItems": 50
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/phase" }
        }
      }
    },
    "phase": {
      "type": "object",
      "required": ["key", "name", "mode", "selection"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "name": { "$ref": "#/$defs/label" },
        "act": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
        "mode": { "enum": ["once", "loop"] },
        "selection": { "$ref": "#/$defs/selection" },
        "sessionOpening": { "$ref": "#/$defs/optionalSteps" },
        "sessionClosing": { "$ref": "#/$defs/optionalSteps" },
        "phaseOpening": { "$ref": "#/$defs/optionalSteps" },
        "phaseClosing": { "$ref": "#/$defs/optionalSteps" },
        "sceneOpening": { "$ref": "#/$defs/optionalSteps" },
        "sceneClosing": { "$ref": "#/$defs/optionalSteps" },
        "worldTurn": { "$ref": "#/$defs/optionalSteps" }
      }
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "required": ["rule", "sceneTypes"],
          "additionalProperties": false,
          "properties": {
            "rule": { "const": "sequence" },
            "sceneTypes": { "description": "Played in order; a type may repeat.", "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/key" } }
          }
        },
        {
          "type": "object",
          "required": ["rule", "sceneTypes"],
          "additionalProperties": false,
          "properties": {
            "rule": { "const": "player" },
            "sceneTypes": { "description": "One card per type.", "$ref": "#/$defs/uniqueKeys", "minItems": 1, "maxItems": 20 }
          }
        },
        {
          "type": "object",
          "required": ["rule", "table"],
          "additionalProperties": false,
          "properties": {
            "rule": { "const": "oracle" },
            "table": { "description": "An oracle table whose every entry names a sceneType.", "$ref": "#/$defs/key" }
          }
        }
      ]
    },
    "steps": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/step" }
    },
    "optionalSteps": {
      "description": "A hook step list; empty by default.",
      "type": ["array", "null"],
      "maxItems": 50,
      "items": { "$ref": "#/$defs/step" }
    },
    "stepKey": {
      "description": "Key rule; \"end\" is reserved for \"next\".",
      "$ref": "#/$defs/key",
      "not": { "const": "end" }
    },
    "next": {
      "description": "A later step key of the same list, or \"end\" to end the part.",
      "$ref": "#/$defs/optionalKey"
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/promptStep" },
        { "$ref": "#/$defs/oracleStep" },
        { "$ref": "#/$defs/tableStep" },
        { "$ref": "#/$defs/rollStep" },
        { "$ref": "#/$defs/choiceStep" },
        { "$ref": "#/$defs/conditionStep" },
        { "$ref": "#/$defs/pickStep" },
        { "$ref": "#/$defs/characterStep" }
      ]
    },
    "characterStep": {
      "description": "Completes with the Character the player picks, or creates from the step.",
      "type": "object",
      "required": ["key", "kind", "title"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/stepKey" },
        "kind": { "const": "character" },
        "title": { "$ref": "#/$defs/label" },
        "prompt": { "$ref": "#/$defs/optionalText2000" },
        "tip": { "$ref": "#/$defs/optionalText2000" },
        "mandatory": { "$ref": "#/$defs/optionalFlag" },
        "next": { "$ref": "#/$defs/next" },
        "effects": { "$ref": "#/$defs/optionalEffects" }
      }
    },
    "promptStep": {
      "description": "The player writes an answer.",
      "type": "object",
      "required": ["key", "kind", "title"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/stepKey" },
        "kind": { "const": "prompt" },
        "title": { "$ref": "#/$defs/label" },
        "prompt": { "$ref": "#/$defs/optionalText2000" },
        "tip": { "$ref": "#/$defs/optionalText2000" },
        "mandatory": { "$ref": "#/$defs/optionalFlag" },
        "next": { "$ref": "#/$defs/next" },
        "effects": { "$ref": "#/$defs/optionalEffects" }
      }
    },
    "oracleStep": {
      "description": "Asks a likelihood oracle and branches on its answer.",
      "type": "object",
      "required": ["key", "kind", "title", "oracle"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/stepKey" },
        "kind": { "const": "oracle" },
        "title": { "$ref": "#/$defs/label" },
        "prompt": { "$ref": "#/$defs/optionalText2000" },
        "tip": { "$ref": "#/$defs/optionalText2000" },
        "mandatory": { "$ref": "#/$defs/optionalFlag" },
        "next": { "$ref": "#/$defs/next" },
        "effects": { "$ref": "#/$defs/optionalEffects" },
        "oracle": { "description": "A likelihood oracle key.", "$ref": "#/$defs/key" },
        "likelihood": { "description": "A level key of that oracle.", "$ref": "#/$defs/optionalKey" },
        "branches": {
          "description": "An exceptional answer without its branch uses yes / no.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "yes": { "$ref": "#/$defs/optionalOutcome" },
                "no": { "$ref": "#/$defs/optionalOutcome" },
                "exceptionalYes": { "$ref": "#/$defs/optionalOutcome" },
                "exceptionalNo": { "$ref": "#/$defs/optionalOutcome" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "tableStep": {
      "description": "Rolls an oracle table and branches per rolled entry.",
      "type": "object",
      "required": ["key", "kind", "title", "table"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/stepKey" },
        "kind": { "const": "table" },
        "title": { "$ref": "#/$defs/label" },
        "prompt": { "$ref": "#/$defs/optionalText2000" },
        "tip": { "$ref": "#/$defs/optionalText2000" },
        "mandatory": { "$ref": "#/$defs/optionalFlag" },
        "next": { "$ref": "#/$defs/next" },
        "effects": { "$ref": "#/$defs/optionalEffects" },
        "table": { "description": "An oracle table key.", "$ref": "#/$defs/key" },
        "branches": {
          "type": ["array", "null"],
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["entry"],
            "additionalProperties": false,
            "properties": {
              "entry": { "description": "An entry key of the step's table, unique in the list.", "$ref": "#/$defs/key" },
              "next": { "$ref": "#/$defs/next" },
              "effects": { "$ref": "#/$defs/optionalEffects" }
            }
          }
        },
        "otherwise": { "$ref": "#/$defs/optionalOutcome" }
      }
    },
    "rollStep": {
      "description": "Rolls dice and branches on the total.",
      "type": "object",
      "required": ["key", "kind", "title", "dice"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/stepKey" },
        "kind": { "const": "roll" },
        "title": { "$ref": "#/$defs/label" },
        "prompt": { "$ref": "#/$defs/optionalText2000" },
        "tip": { "$ref": "#/$defs/optionalText2000" },
        "mandatory": { "$ref": "#/$defs/optionalFlag" },
        "next": { "$ref": "#/$defs/next" },
        "effects": { "$ref": "#/$defs/optionalEffects" },
        "dice": { "description": "Dice notation, e.g. 1d6.", "type": "string", "minLength": 1, "maxLength": 100 },
        "bands": {
          "type": ["array", "null"],
          "maxItems": 20,
          "items": { "$ref": "#/$defs/band" }
        }
      }
    },
    "choiceStep": {
      "description": "The player picks one option. A suggested choice names the option a skip follows.",
      "type": "object",
      "required": ["key", "kind", "title", "options"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/stepKey" },
        "kind": { "const": "choice" },
        "title": { "$ref": "#/$defs/label" },
        "prompt": { "$ref": "#/$defs/optionalText2000" },
        "tip": { "$ref": "#/$defs/optionalText2000" },
        "mandatory": { "$ref": "#/$defs/optionalFlag" },
        "next": { "$ref": "#/$defs/next" },
        "effects": { "$ref": "#/$defs/optionalEffects" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "#/$defs/key" },
              "label": { "$ref": "#/$defs/label" },
              "next": { "$ref": "#/$defs/next" },
              "effects": { "$ref": "#/$defs/optionalEffects" }
            }
          }
        },
        "skip": { "description": "The option key a skipped choice follows.", "$ref": "#/$defs/optionalKey" }
      }
    },
    "conditionStep": {
      "description": "Compares a tracker, or the number of open NPCs or Threads, to bands; never mandatory, never skipped, writes no entry. Exactly one of tracker or count.",
      "type": "object",
      "required": ["key", "kind", "title", "bands"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/stepKey" },
        "kind": { "const": "condition" },
        "title": { "$ref": "#/$defs/label" },
        "prompt": { "$ref": "#/$defs/optionalText2000" },
        "tip": { "$ref": "#/$defs/optionalText2000" },
        "mandatory": { "enum": [false, null] },
        "next": { "$ref": "#/$defs/next" },
        "effects": { "$ref": "#/$defs/optionalEffects" },
        "tracker": { "$ref": "#/$defs/optionalKey" },
        "count": {
          "anyOf": [{ "$ref": "#/$defs/conditionCount" }, { "type": "null" }]
        },
        "bands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/band" }
        }
      },
      "oneOf": [
        {
          "required": ["tracker"],
          "properties": {
            "tracker": { "$ref": "#/$defs/key" },
            "count": { "type": "null" }
          }
        },
        {
          "required": ["count"],
          "properties": {
            "count": { "$ref": "#/$defs/conditionCount" },
            "tracker": { "type": "null" }
          }
        }
      ]
    },
    "conditionCount": {
      "description": "The number of open items of a kind carrying all the tags.",
      "type": "object",
      "required": ["of"],
      "additionalProperties": false,
      "properties": {
        "of": { "enum": ["npc", "thread", "character"] },
        "tags": { "$ref": "#/$defs/tagKeys" }
      }
    },
    "pickStep": {
      "description": "Picks open NPCs, Threads or Characters carrying all the tags: at random, or chosen by the player. Outcome found or none.",
      "type": "object",
      "required": ["key", "kind", "title", "of", "mode"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/stepKey" },
        "kind": { "const": "pick" },
        "title": { "$ref": "#/$defs/label" },
        "prompt": { "$ref": "#/$defs/optionalText2000" },
        "tip": { "$ref": "#/$defs/optionalText2000" },
        "mandatory": { "$ref": "#/$defs/optionalFlag" },
        "next": { "$ref": "#/$defs/next" },
        "effects": { "$ref": "#/$defs/optionalEffects" },
        "of": { "enum": ["npc", "thread", "character"] },
        "tags": { "$ref": "#/$defs/tagKeys" },
        "mode": { "enum": ["random", "choose"] },
        "count": {
          "description": "How many to pick; {1, 1} by default. min must not exceed max.",
          "anyOf": [
            {
              "type": "object",
              "required": ["min", "max"],
              "additionalProperties": false,
              "properties": {
                "min": { "type": "integer", "minimum": 1, "maximum": 10 },
                "max": { "type": "integer", "minimum": 1, "maximum": 10 }
              }
            },
            { "type": "null" }
          ]
        },
        "branches": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "found": { "$ref": "#/$defs/optionalOutcome" },
                "none": { "$ref": "#/$defs/optionalOutcome" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "optionalOutcome": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "next": { "$ref": "#/$defs/next" },
            "effects": { "$ref": "#/$defs/optionalEffects" }
          }
        },
        { "type": "null" }
      ]
    },
    "band": {
      "description": "An outcome band: ordered upper bounds; only the last omits upTo and catches the rest.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upTo": {
          "anyOf": [{ "type": "integer" }, { "$ref": "#/$defs/trackerRef" }, { "type": "null" }]
        },
        "next": { "$ref": "#/$defs/next" },
        "effects": { "$ref": "#/$defs/optionalEffects" }
      }
    },
    "optionalEffects": {
      "type": ["array", "null"],
      "maxItems": 10,
      "items": { "$ref": "#/$defs/effect" }
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "tracker", "op", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "tracker" },
            "tracker": { "$ref": "#/$defs/key" },
            "op": { "enum": ["add", "set"] },
            "value": {
              "anyOf": [{ "type": "integer", "minimum": -1000, "maximum": 1000 }, { "$ref": "#/$defs/trackerRef" }]
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "sceneType"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "nextScene" },
            "sceneType": { "$ref": "#/$defs/key" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "sceneType"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "switchSceneType" },
            "sceneType": { "$ref": "#/$defs/key" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "endPhase" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "title"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "sceneTitle" },
            "title": { "$ref": "#/$defs/label" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "createNpc" },
            "name": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
            "agenda": { "type": ["string", "null"], "maxLength": 2000 },
            "tags": { "$ref": "#/$defs/tagKeys" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "createThread" },
            "name": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
            "tags": { "$ref": "#/$defs/tagKeys" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "closeThread" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "slot"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "fillFact" },
            "slot": { "$ref": "#/$defs/key" },
            "text": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000 }
          }
        }
      ]
    }
  }
}
