    "oracles": {
        "tables": [
            {
                "key": "toxic-power",
                "name": "Toxic power",
                "dice": "1d6",
                "entries": [
                    {
                        "min": 1,
                        "max": 1,
                        "text": "Conqueror: the villain takes what is not theirs by force"
                    },
                    {
                        "min": 2,
                        "max": 2,
                        "text": "Corrupter: the villain bends others into serving their schemes"
                    },
                    {
                        "min": 3,
                        "max": 3,
                        "text": "Affliction: a curse or sickness spreads wherever the villain goes"
                    },
                    {
                        "min": 4,
                        "max": 4,
                        "text": "Tyrannical authority: rules and rank are used as weapons"
                    },
                    {
                        "min": 5,
                        "max": 5,
                        "text": "Complacent privilege: comfort is guarded and everyone else pays"
                    },
                    {
                        "min": 6,
                        "max": 6,
                        "text": "Well-meaning liabilities: good intentions leave a trail of harm"
                    }
                ]
            },
            {
                "key": "story-element",
                "name": "Story element",
                "dice": "1d8",
                "entries": [
                    {
                        "min": 1,
                        "max": 1,
                        "text": "Mystery: a riddle hides behind the evening's glamour"
                    },
                    {
                        "min": 2,
                        "max": 2,
                        "text": "Intrigue: whispers, forged letters and double dealing"
                    },
                    {
                        "min": 3,
                        "max": 3,
                        "text": "Celebration: a grand ball, festival or wedding is under way"
                    },
                    {
                        "min": 4,
                        "max": 4,
                        "text": "Utopia: a shining ideal community that hides a rotten price"
                    },
                    {
                        "min": 5,
                        "max": 5,
                        "text": "Invasion: an outside force lands on the shore"
                    },
                    {
                        "min": 6,
                        "max": 6,
                        "text": "Revolution: the people are ready to topple the throne"
                    },
                    {
                        "min": 7,
                        "max": 7,
                        "text": "Relationship triangle: three hearts pull in different directions"
                    },
                    {
                        "min": 8,
                        "max": 8,
                        "text": "Couple with an obstacle: two people in love, one thing in the way"
                    }
                ]
            },
            {
                "key": "romantic-complication",
                "name": "Romantic complication",
                "dice": "1d8",
                "entries": [
                    {
                        "min": 1,
                        "max": 1,
                        "text": "Rival suitor: someone else has eyes on your crush"
                    },
                    {
                        "min": 2,
                        "max": 2,
                        "text": "Old flame: a past lover turns up at the worst moment"
                    },
                    {
                        "min": 3,
                        "max": 3,
                        "text": "Misunderstanding: a half-heard remark is taken the wrong way"
                    },
                    {
                        "min": 4,
                        "max": 4,
                        "text": "Duty versus desire: orders or family expectations pull you apart"
                    },
                    {
                        "min": 5,
                        "max": 5,
                        "text": "Stolen letter: a private note ends up in the wrong hands"
                    },
                    {
                        "min": 6,
                        "max": 6,
                        "text": "Jealous friend: an ally lashes out over feelings"
                    },
                    {
                        "min": 7,
                        "max": 7,
                        "text": "Secret identity: your crush is hiding who they really are"
                    },
                    {
                        "min": 8,
                        "max": 8,
                        "text": "Bad timing: a vow or promise blocks the moment"
                    }
                ]
            },
            {
                "key": "location",
                "name": "Location",
                "dice": "1d8",
                "entries": [
                    {
                        "min": 1,
                        "max": 1,
                        "text": "A moonlit balcony above a lantern-lit courtyard"
                    },
                    {
                        "min": 2,
                        "max": 2,
                        "text": "A crowded harbor tavern full of sailors and secrets"
                    },
                    {
                        "min": 3,
                        "max": 3,
                        "text": "A candlelit ballroom with a quartet and a hundred masks"
                    },
                    {
                        "min": 4,
                        "max": 4,
                        "text": "A windswept cliff-top fortress with crumbling stairs"
                    },
                    {
                        "min": 5,
                        "max": 5,
                        "text": "A hidden smugglers' cove at low tide"
                    },
                    {
                        "min": 6,
                        "max": 6,
                        "text": "A rooftop garden overlooking the sleeping city"
                    },
                    {
                        "min": 7,
                        "max": 7,
                        "text": "The deck of a creaking galleon at dusk"
                    },
                    {
                        "min": 8,
                        "max": 8,
                        "text": "A hall of mirrors in an abandoned theater"
                    }
                ]
            },
            {
                "key": "villains-next-move",
                "name": "Villain's next move",
                "dice": "1d8",
                "entries": [
                    {
                        "min": 1,
                        "max": 1,
                        "text": "Strikes at an ally while the heroes are looking elsewhere"
                    },
                    {
                        "min": 2,
                        "max": 2,
                        "text": "Spreads a vicious rumor that turns the town against the heroes"
                    },
                    {
                        "min": 3,
                        "max": 3,
                        "text": "Tightens a grip on the district, and the toxic power grows"
                    },
                    {
                        "min": 4,
                        "max": 4,
                        "text": "Kidnaps someone the heroes care about"
                    },
                    {
                        "min": 5,
                        "max": 5,
                        "text": "Offers a tempting bargain that would cost them dearly"
                    },
                    {
                        "min": 6,
                        "max": 6,
                        "text": "Moves the grand plan one step closer: advance the Countdown"
                    },
                    {
                        "min": 7,
                        "max": 7,
                        "text": "Sets a trap baited with something the heroes want"
                    },
                    {
                        "min": 8,
                        "max": 8,
                        "text": "Reveals a hidden ally or a secret that changes the stakes"
