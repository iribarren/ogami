    "flows": [
        {
            "key": "one-shot",
            "name": "One-shot",
            "description": "A single-evening swashbuckling romance: set up a villain and a goal, play scenes, then confront the villain.",
            "introduction": "You are the whole table. Describe what happens, roll when a move applies, and let the questions guide you. Pick your playbook, name your character, then set the villain and goal in the Setup phase. In Scenes, choose a scene type each time and play it out; every miss earns experience. When the Countdown runs low or the scenes feel done, move to the Climax and confront the villain.",
            "default": true,
            "defaultView": "focus",
            "oracles": [
                "toxic-power",
                "story-element",
                "romantic-complication",
                "villains-next-move",
                "will-it-work",
                "location"
            ],
            "trackers": [
                "countdown"
            ],
            "phases": [
                {
                    "key": "setup",
                    "name": "Setup",
                    "act": "Act I",
                    "description": "Create your hero, then decide who the villain is and what you are after.",
                    "mode": "once",
                    "selection": {
                        "rule": "sequence",
                        "sceneTypes": [
                            "heart-to-heart"
                        ]
                    },
                    "phaseOpening": [
                        {
                            "key": "character-1",
                            "kind": "character",
                            "title": "Create your hero",
                            "prompt": "Pick a playbook, name your hero and set your five stats. Note who you hold a String on.",
                            "mandatory": true
                        },
                        {
                            "key": "table-1",
                            "kind": "table",
                            "title": "Name the toxic power",
                            "prompt": "Roll to learn what rotten force the villain wields, then say how it shows up in town.",
                            "mandatory": true,
                            "table": "toxic-power"
                        },
                        {
                            "key": "table-2",
                            "kind": "table",
                            "title": "Choose the story element",
                            "prompt": "Roll to find the shape of the evening's story, then fit it around your hero and the villain.",
                            "mandatory": true,
                            "table": "story-element"
                        },
                        {
                            "key": "prompt-1",
                            "kind": "prompt",
                            "title": "Who is the villain? Give a name.",
                            "prompt": "Name the villain in a few words.",
                            "tip": "This name becomes their NPC in the cast. Their scheme comes from the Toxic power you just rolled.",
                            "mandatory": true,
                            "effects": [
                                {
                                    "kind": "createNpc",
                                    "name": "{answer}",
                                    "agenda": "Advance the plan and crush anyone who stands in the way.",
                                    "tags": [
                                        "villain"
                                    ]
                                }
                            ],
                            "inspiration": [
                                "toxic-power"
                            ]
                        },
                        {
                            "key": "prompt-2",
                            "kind": "prompt",
                            "title": "What is your goal tonight? A few words.",
                            "prompt": "State what your hero wants by the end of the night, in a few words.",
                            "mandatory": true,
                            "effects": [
                                {
                                    "kind": "createThread",
                                    "name": "{answer}"
                                }
                            ]
                        }
                    ]
                },
                {
                    "key": "scenes",
                    "name": "Scenes",
                    "act": "Act II",
                    "description": "Play scene after scene. Pick the kind of scene, state what you want from it, and roll when a move applies.",
                    "mode": "loop",
                    "selection": {
                        "rule": "player",
                        "sceneTypes": [
                            "swashbuckle",
                            "heart-to-heart",
                            "intrigue"
                        ]
                    },
                    "sceneOpening": [
                        {
                            "key": "prompt-1",
                            "kind": "prompt",
                            "title": "Set your intent",
                            "prompt": "What does your hero want from this scene, and where is it set? Give the scene a short title.",
                            "mandatory": true,
                            "effects": [
                                {
                                    "kind": "sceneTitle",
                                    "title": "{answer}"
                                }
                            ]
                        },
                        {
                            "key": "table-1",
                            "kind": "table",
                            "title": "Add a complication",
                            "prompt": "Roll for a romantic complication and work it into the scene.",
                            "mandatory": true,
                            "table": "romantic-complication"
                        },
                        {
                            "key": "check-1",
                            "kind": "check",
                            "title": "Make your move",
                            "prompt": "Face the complication head on. This step rolls Defy Disaster (Daring). To act another way, roll another move first with Roll a check on the character sheet. A miss marks XP.",
                            "mandatory": true,
                            "effects": [
                                {
                                    "kind": "tracker",
                                    "tracker": "countdown",
                                    "op": "add",
                                    "value": 1
                                }
                            ],
                            "check": "defy-disaster-daring",
                            "outcomes": [
                                {
                                    "band": "miss",
                                    "effects": [
                                        {
                                            "kind": "sheet",
                                            "field": "xp",
                                            "op": "add",
                                            "value": 1
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "key": "climax",
                    "name": "Climax",
                    "act": "Act III",
                    "description": "Confront the villain, then look back on the night and tally your experience.",
                    "mode": "once",
                    "selection": {
                        "rule": "sequence",
                        "sceneTypes": [
                            "swashbuckle"
                        ]
                    },
                    "phaseOpening": [
                        {
                            "key": "check-1",
                            "kind": "check",
                            "title": "Confront the villain",
                            "prompt": "Face the villain with everything you have. Fight with Daring; use a String as the roll modifier if one applies.",
                            "mandatory": true,
                            "check": "fight-daring",
                            "outcomes": [
                                {
                                    "band": "miss",
                                    "effects": [
                                        {
                                            "kind": "sheet",
                                            "field": "xp",
                                            "op": "add",
                                            "value": 1
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "phaseClosing": [
                        {
                            "key": "choice-1",
                            "kind": "choice",
                            "title": "Did you learn something about yourself or the villain?",
                            "prompt": "Think back over the night. If you learned something about yourself or about the villain, mark 1 XP.",
                            "mandatory": true,
                            "options": [
                                {
                                    "key": "no",
                                    "label": "No"
                                },
                                {
                                    "key": "yes",
                                    "label": "Yes"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
