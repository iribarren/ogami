{
  "schemaVersion": 2,
  "gameSystem": {
    "key": "mythic-style",
    "name": "Mythic-style",
    "description": "Inspired by fate-chart style solo play: questions by likelihood shifted by a chaos factor, with exceptional answers, plus meaning and event focus tables. Original content; this is not the Mythic Game Master Emulator."
  },
  "theme": "parchment",
  "oracles": {
    "tables": [
      {"key": "scene-adjustments", "name": "Scene adjustments", "dice": "1d6", "entries": [{"min": 1, "max": 1, "text": "Someone you expected is missing"}, {"min": 2, "max": 2, "text": "Someone unexpected is there"}, {"min": 3, "max": 3, "text": "The place is not what you thought"}, {"min": 4, "max": 4, "text": "It happens later than planned"}, {"min": 5, "max": 5, "text": "The mood is wrong"}, {"min": 6, "max": 6, "text": "An obstacle is in the way"}]},
      {
        "key": "meaning-action",
        "name": "Meaning: action",
        "entries": [
          {"text": "Mend"},
          {"text": "Hide"},
          {"text": "Gather"},
          {"text": "Bargain"},
          {"text": "Climb"},
          {"text": "Forge"},
          {"text": "Whisper"},
          {"text": "Unravel"},
          {"text": "Shelter"},
          {"text": "Wander"},
          {"text": "Sow"},
          {"text": "Kindle"},
          {"text": "Smuggle"},
          {"text": "Chart"},
          {"text": "Lure"},
          {"text": "Dig"},
          {"text": "Bind"},
          {"text": "Unmask"},
          {"text": "Rescue"},
          {"text": "Sabotage"},
          {"text": "Hoard"},
          {"text": "Confess"},
          {"text": "Scatter"},
          {"text": "Echo"},
          {"text": "Weave"},
          {"text": "Summon"},
          {"text": "Hunt"},
          {"text": "Bury"},
          {"text": "Wait"},
          {"text": "Awaken"}
        ]
      },
      {
        "key": "meaning-subject",
        "name": "Meaning: subject",
        "entries": [
          {"text": "A debt"},
          {"text": "An heirloom"},
          {"text": "The border"},
          {"text": "A hidden passage"},
          {"text": "Family"},
          {"text": "A guild"},
          {"text": "The harvest"},
          {"text": "A broken oath"},
          {"text": "An omen"},
          {"text": "A map"},
          {"text": "The old road"},
          {"text": "A forgotten name"},
          {"text": "Ashes"},
          {"text": "A ledger"},
          {"text": "The tide"},
          {"text": "A lantern"},
          {"text": "A wager"},
          {"text": "A crown"},
          {"text": "A bridge"},
          {"text": "A fever"},
          {"text": "A song"},
          {"text": "Memory"},
          {"text": "A witness"},
          {"text": "Coin"},
          {"text": "A refuge"},
          {"text": "A vow"},
          {"text": "The night watch"},
          {"text": "A relic"},
          {"text": "The stars"},
          {"text": "A key"}
        ]
      },
      {
        "key": "random-event-focus",
        "name": "Random event focus",
        "dice": "1d100",
        "entries": [
          {"min": 1, "max": 8, "key": "far-away", "text": "Something changes far away"},
          {"min": 9, "max": 20, "key": "rival-acts", "text": "A rival makes a move"},
          {"min": 21, "max": 28, "key": "stranger", "text": "A stranger enters the story"},
          {"min": 29, "max": 38, "key": "lead-clearer", "text": "A lead becomes clearer"},
          {"min": 39, "max": 45, "key": "lead-cold", "text": "A lead goes cold"},
          {"min": 46, "max": 52, "key": "loose-end", "text": "A loose end is settled"},
          {"min": 53, "max": 62, "key": "trouble", "text": "Trouble finds you"},
          {"min": 63, "max": 70, "key": "luck", "text": "Luck turns your way"},
          {"min": 71, "max": 80, "key": "ally-help", "text": "An ally needs something"},
          {"min": 81, "max": 88, "key": "old-choice", "text": "An old choice comes due"},
          {"min": 89, "max": 94, "key": "surroundings", "text": "The surroundings shift"},
          {"min": 95, "max": 100, "key": "odd-sign", "text": "A quiet moment hides a clue"}
        ]
      }
    ],
    "likelihood": [
      {
        "key": "fate",
        "name": "Fate question",
        "sides": 100,
        "levels": [
          {"key": "impossible", "label": "Impossible", "target": 5},
          {"key": "nearly-impossible", "label": "Nearly impossible", "target": 15},
          {"key": "very-unlikely", "label": "Very unlikely", "target": 25},
          {"key": "unlikely", "label": "Unlikely", "target": 35},
          {"key": "even", "label": "Even odds", "target": 50},
          {"key": "likely", "label": "Likely", "target": 65},
          {"key": "very-likely", "label": "Very likely", "target": 75},
          {"key": "nearly-certain", "label": "Nearly certain", "target": 85},
          {"key": "certain", "label": "Certain", "target": 95}
        ],
        "chaos": {"min": 1, "max": 9, "neutral": 5, "shiftPerPoint": 5, "tracker": "chaos"},
        "exceptionalPercent": 20,
        "randomEvent": {"table": "random-event-focus"}
      }
    ]
  },
  "tags": [
    {"key": "rival", "label": "Rival", "hint": "Someone working against your goals"},
    {"key": "ally", "label": "Ally", "hint": "Someone on your side"}
  ],
  "trackers": [
    {"key": "chaos", "name": "Chaos factor", "hint": "High chaos: more yes answers, more surprises", "kind": "counter", "min": 1, "max": 9, "initial": 5}
  ],
  "factSlots": [],
  "sceneTypes": [
    {"key": "scene", "name": "Scene", "purpose": "Play out one scene.", "oracles": ["fate", "meaning-action", "meaning-subject", "random-event-focus"], "setup": [], "play": [], "closing": []}
  ],
  "flows": [
    {
      "key": "mythic", "name": "Mythic-style adventure", "description": "Expected scenes, scene checks against the chaos factor, and lists you keep up to date.", "default": true, "defaultView": "journal", "oracles": ["fate", "scene-adjustments", "random-event-focus", "meaning-action", "meaning-subject"], "trackers": ["chaos"],
      "phases": [
        {
          "key": "premise", "name": "Premise", "mode": "once", "selection": {"rule": "sequence", "sceneTypes": ["scene"]},
          "sceneOpening": [
            {"key": "premise", "kind": "prompt", "title": "What is the premise?", "mandatory": true},
            {"key": "goal", "kind": "prompt", "title": "What is your first goal?", "effects": [{"kind": "createThread", "name": "{answer}"}]},
            {"key": "involved", "kind": "prompt", "title": "Who is involved?", "effects": [{"kind": "createNpc", "name": "{answer}"}]}
          ]
        },
        {
          "key": "adventure", "name": "Adventure", "mode": "loop", "selection": {"rule": "player", "sceneTypes": ["scene"]},
          "sceneOpening": [
            {"key": "expected", "kind": "prompt", "title": "What scene do you expect?", "mandatory": true, "effects": [{"kind": "sceneTitle", "title": "{answer}"}]},
            {"key": "check", "kind": "roll", "title": "Scene check", "tip": "Roll at or under the chaos factor ({tracker:chaos}) and the scene changes.", "dice": "1d10", "bands": [{"upTo": {"tracker": "chaos"}}, {"next": "end"}]},
            {"key": "twist", "kind": "roll", "title": "Altered or interrupted?", "dice": "1d6", "bands": [{"upTo": 3}, {"next": "interrupt"}]},
            {"key": "adjust", "kind": "table", "title": "How is it adjusted?", "table": "scene-adjustments"},
            {"key": "altered", "kind": "prompt", "title": "How is the scene altered?", "next": "end"},
            {"key": "interrupt", "kind": "table", "title": "What interrupts the scene?", "table": "random-event-focus", "branches": [
              {"entry": "rival-acts", "next": "rival"},
              {"entry": "stranger", "next": "instead-npc", "effects": [{"kind": "createNpc", "name": "A stranger"}]},
              {"entry": "lead-clearer", "next": "lead"},
              {"entry": "lead-cold", "next": "lead"},
              {"entry": "loose-end", "next": "loose"},
              {"entry": "ally-help", "next": "ally"}
            ], "otherwise": {"next": "action"}},
            {"key": "rival", "kind": "pick", "title": "Which rival acts?", "of": "npc", "tags": ["rival"], "mode": "random", "next": "instead-npc", "branches": {"none": {"effects": [{"kind": "createNpc", "name": "A new rival", "tags": ["rival"]}]}}},
            {"key": "lead", "kind": "pick", "title": "Which lead is it?", "of": "thread", "mode": "choose", "branches": {"found": {"next": "instead-thread"}, "none": {"next": "instead"}}},
            {"key": "loose", "kind": "pick", "title": "Which loose end settles?", "of": "thread", "mode": "choose", "branches": {"found": {"next": "close"}, "none": {"next": "instead"}}},
            {"key": "close", "kind": "choice", "title": "Close it?", "mandatory": true, "options": [{"key": "yes", "label": "Yes", "next": "instead-thread", "effects": [{"kind": "closeThread"}]}, {"key": "no", "label": "No", "next": "instead-thread"}]},
            {"key": "ally", "kind": "pick", "title": "Which ally needs help?", "of": "npc", "tags": ["ally"], "mode": "choose", "branches": {"found": {"next": "instead-npc"}, "none": {"next": "instead"}}},
            {"key": "instead-npc", "kind": "prompt", "title": "What happens instead?", "prompt": "Involve {picked}.", "mandatory": true, "next": "end", "effects": [{"kind": "sceneTitle", "title": "{answer}"}]},
            {"key": "instead-thread", "kind": "prompt", "title": "What happens instead?", "prompt": "Tie it to {picked}.", "mandatory": true, "next": "end", "effects": [{"kind": "sceneTitle", "title": "{answer}"}]},
            {"key": "action", "kind": "table", "title": "Meaning: what happens?", "table": "meaning-action"},
            {"key": "subject", "kind": "table", "title": "Meaning: about what?", "table": "meaning-subject"},
            {"key": "instead", "kind": "prompt", "title": "What happens instead?", "prompt": "Describe what interrupts the expected scene.", "mandatory": true, "effects": [{"kind": "sceneTitle", "title": "{answer}"}]}
          ],
          "sceneClosing": [
            {"key": "control", "kind": "choice", "title": "Were you in control?", "mandatory": true, "options": [{"key": "yes", "label": "Yes", "effects": [{"kind": "tracker", "tracker": "chaos", "op": "add", "value": -1}]}, {"key": "no", "label": "No", "effects": [{"kind": "tracker", "tracker": "chaos", "op": "add", "value": 1}]}]},
            {"key": "lists", "kind": "prompt", "title": "Update your lists"}
          ]
        }
      ]
    }
  ],
  "sheet": {},
  "checks": []
}
