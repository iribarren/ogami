{
  "schemaVersion": 2,
  "gameSystem": {
    "key": "west-marches",
    "name": "West Marches",
    "description": "A West Marches campaign for solo play, 5E compatible, on the SRD 5.2.1: a town, a roster of adventurers and one expedition per session, with rations, torches, abstract combat and encounters by distance. Original content: the flow, the tables and the sheet.",
