      {"key": "dex", "label": "Dexterity", "hint": "Roll 4d6 and keep the best three, or spend 72 points between 8 and 15 (the standard array fits).", "group": "Abilities", "type": "number", "min": 3, "max": 20, "default": 10, "roll": {"dice": "4d6kh3"}},
      {"key": "con", "label": "Constitution", "hint": "Roll 4d6 and keep the best three, or spend 72 points between 8 and 15 (the standard array fits).", "group": "Abilities", "type": "number", "min": 3, "max": 20, "default": 10, "roll": {"dice": "4d6kh3"}},
      {"key": "int", "label": "Intelligence", "hint": "Roll 4d6 and keep the best three, or spend 72 points between 8 and 15 (the standard array fits).", "group": "Abilities", "type": "number", "min": 3, "max": 20, "default": 10, "roll": {"dice": "4d6kh3"}},
      {"key": "wis", "label": "Wisdom", "hint": "Roll 4d6 and keep the best three, or spend 72 points between 8 and 15 (the standard array fits).", "group": "Abilities", "type": "number", "min": 3, "max": 20, "default": 10, "roll": {"dice": "4d6kh3"}},
      {"key": "cha", "label": "Charisma", "hint": "Roll 4d6 and keep the best three, or spend 72 points between 8 and 15 (the standard array fits).", "group": "Abilities", "type": "number", "min": 3, "max": 20, "default": 10, "roll": {"dice": "4d6kh3"}},
      {"key": "str-mod", "label": "Str modifier", "group": "Abilities", "type": "derived", "formula": "({str}-10)/2"},
      {"key": "dex-mod", "label": "Dex modifier", "group": "Abilities", "type": "derived", "formula": "({dex}-10)/2"},
      {"key": "con-mod", "label": "Con modifier", "group": "Abilities", "type": "derived", "formula": "({con}-10)/2"},
      {"key": "int-mod", "label": "Int modifier", "group": "Abilities", "type": "derived", "formula": "({int}-10)/2"},
      {"key": "wis-mod", "label": "Wis modifier", "group": "Abilities", "type": "derived", "formula": "({wis}-10)/2"},
      {"key": "cha-mod", "label": "Cha modifier", "group": "Abilities", "type": "derived", "formula": "({cha}-10)/2"},
      {"key": "prof", "label": "Proficiency bonus", "group": "Abilities", "type": "derived", "formula": "2+({level}-1)/4"},
      {"key": "ac", "label": "Armor Class", "hint": "Set it from your armor, shield and Dexterity.", "group": "Combat", "type": "number", "min": 0, "max": 30, "default": 10},
      {"key": "hit-die", "label": "Hit die", "hint": "The size of your class's hit die: 6, 8, 10 or 12.", "group": "Combat", "type": "number", "min": 6, "max": 12, "default": 8},
      {"key": "hp", "label": "Hit points", "group": "Combat", "type": "track", "startMax": {"formula": "max(1,{hit-die}+{con-mod})"}},
      {"key": "hit-dice", "label": "Hit dice", "hint": "A short rest spends one.", "group": "Combat", "type": "track", "startMax": {"formula": "{level}"}},
      {"key": "death-saves", "label": "Failed death saves", "hint": "Three and the adventurer dies.", "group": "Combat", "type": "number", "min": 0, "max": 3, "default": 0},
      {"key": "exhaustion", "label": "Exhaustion", "hint": "Each level takes 2 from every d20 test. A long rest removes one.", "group": "Combat", "type": "number", "min": 0, "max": 6, "default": 0},
      {"key": "conditions", "label": "Conditions", "hint": "Mark and clear them as they happen. Exhaustion has its own field.", "group": "Combat", "type": "conditions", "options": [{"key": "blinded", "label": "Blinded"}, {"key": "charmed", "label": "Charmed"}, {"key": "deafened", "label": "Deafened"}, {"key": "frightened", "label": "Frightened"}, {"key": "grappled", "label": "Grappled"}, {"key": "incapacitated", "label": "Incapacitated"}, {"key": "invisible", "label": "Invisible"}, {"key": "paralyzed", "label": "Paralyzed"}, {"key": "petrified", "label": "Petrified"}, {"key": "poisoned", "label": "Poisoned"}, {"key": "prone", "label": "Prone"}, {"key": "restrained", "label": "Restrained"}, {"key": "stunned", "label": "Stunned"}, {"key": "unconscious", "label": "Unconscious"}]},
      {"key": "casting-mod", "label": "Spellcasting modifier", "hint": "The modifier of your spellcasting ability.", "group": "Spellcasting", "type": "number", "min": -5, "max": 10, "default": 0},
      {"key": "slots-1", "label": "Level 1 slots", "hint": "Set the maximum for your class and level. Leave it at 0 if you cast none.", "group": "Spellcasting", "type": "track"},
      {"key": "slots-2", "label": "Level 2 slots", "group": "Spellcasting", "type": "track"},
