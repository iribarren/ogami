      {"key": "gp", "label": "Gold", "hint": "Gold pieces. Shops and inns take it.", "group": "Kit", "type": "number", "min": 0, "default": 50},
      {"key": "pack", "label": "Pack", "group": "Kit", "type": "inventory", "capacity": 30, "categories": ["Gear", "Weapons", "Armor"]}
    ],
    "pointBudget": {"label": "Ability points", "total": 72, "fields": ["str", "dex", "con", "int", "wis", "cha"], "min": 8, "max": 15},
