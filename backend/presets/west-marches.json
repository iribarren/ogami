      "notice": "This work includes material from the System Reference Document 5.2.1 (“SRD 5.2.1”) by Wizards of the Coast LLC, available at https://www.dndbeyond.com/srd. The SRD 5.2.1 is licensed under the Creative Commons Attribution 4.0 International License, available at https://creativecommons.org/licenses/by/4.0/legalcode. Rules summarized and adapted for guided solo play.",
      "license": "CC BY 4.0",
      "url": "https://creativecommons.org/licenses/by/4.0/legalcode"
    }
  },
  "theme": "parchment",
  "oracles": {
    "tables": [],
    "likelihood": [
      {"key": "fate", "name": "Fate question", "sides": 100, "levels": [{"key": "unlikely", "label": "Unlikely", "target": 30}, {"key": "even", "label": "50/50", "target": 50}, {"key": "likely", "label": "Likely", "target": 70}], "exceptionalPercent": 20}
    ]
  },
  "tags": [
    {"key": "hireling", "label": "Hireling", "hint": "Hired help who may follow you out", "appliesTo": ["npc"]},
    {"key": "patron", "label": "Patron", "hint": "Someone who pays for the wilds to be explored", "appliesTo": ["npc"]},
    {"key": "rival", "label": "Rival", "hint": "A party after the same prize", "appliesTo": ["npc"]},
    {"key": "monster", "label": "Monster", "hint": "A foe you have met", "appliesTo": ["npc"]},
    {"key": "town", "label": "Town", "appliesTo": ["place"]},
    {"key": "site", "label": "Site", "hint": "A place worth another visit", "appliesTo": ["place"]},
    {"key": "near", "label": "Near town", "appliesTo": ["place"]},
    {"key": "mid", "label": "The hills", "appliesTo": ["place"]},
    {"key": "deep", "label": "Deep wilds", "appliesTo": ["place"]}
  ],
  "trackers": [
    {"key": "away", "name": "Days away", "hint": "End the session in town, or the wilds keep you", "kind": "counter", "min": 0, "max": 10, "initial": 0},
    {"key": "rations", "name": "Rations", "hint": "Each leg of travel eats one. At 0 someone goes hungry.", "kind": "counter", "min": 0, "max": 20, "initial": 5},
    {"key": "torches", "name": "Torches burned", "hint": "Each room burns some light. A full clock means the last torch gutters.", "kind": "clock", "segments": 6},
    {"key": "foe", "name": "Foe's hits", "hint": "Hits left before the foe falls", "kind": "counter", "min": 0, "max": 10, "initial": 0},
    {"key": "threat", "name": "Threat", "hint": "How dangerous the fight is: it sets the damage you take", "kind": "counter", "min": 0, "max": 3, "initial": 0, "levels": [{"upTo": 0, "label": "None"}, {"upTo": 1, "label": "Minor"}, {"upTo": 2, "label": "Tough"}, {"label": "Deadly"}]}
  ],
  "factSlots": [
    {"key": "town", "label": "Town", "type": "place"},
    {"key": "expedition", "label": "Expedition", "type": "thread", "hint": "Renewed each session"},
    {"key": "foe", "label": "Foe", "type": "npc", "hint": "The monster you are fighting"}
  ],
  "sceneTypes": [],
  "flows": [],
