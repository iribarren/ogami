<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- The file is named Campaign.Campaign because the simplified XML driver maps sub-namespaces
         of the App\Play\Domain prefix with dots.
         Identity, ownership, the pinned release, the Flow and the creation time are columns; the
         sessions with their scenes are one JSONB value (ADR 0007, CampaignSessionsType), and so are
         the tracker values, an object of integers by Tracker key (empty: {} or []), and so is the
         FlowRun (CampaignFlowRunType; null when played freely). -->
    <entity name="App\Play\Domain\Campaign\Campaign" table="play_campaign">
        <indexes>
            <!-- A player's campaigns, newest first (DoctrineCampaignRepository::ownedBy). -->
            <index name="idx_play_campaign_owner_created" columns="owner_id,created_at"/>
        </indexes>

        <id name="id" type="guid" column="id"/>

        <field name="ownerId" type="guid" column="owner_id"/>
        <field name="name" type="string" column="name" length="100"/>
        <field name="gameSystemKey" type="string" column="game_system_key" length="64"/>
        <field name="releaseVersion" type="integer" column="release_version"/>
        <field name="gameSystemName" type="string" column="game_system_name" length="255"/>
        <!-- The Flow played, a key of the pinned release; null when played freely. -->
        <field name="flowKey" type="string" column="flow_key" length="64" nullable="true"/>
        <field name="createdAt" type="datetimetz_immutable_microseconds" column="created_at"/>
        <field name="sessions" type="play_campaign_sessions" column="sessions">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
        <field name="trackerValues" type="json" column="tracker_values">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
        <field name="flowRun" type="play_campaign_flow_run" column="flow_run" nullable="true">
            <options>
                <option name="jsonb">true</option>
            </options>
        </field>
        <!-- Optimistic lock: every save bumps it, and a save of a copy loaded before another
             request's save fails (DoctrineCampaignRepository::save). -->
        <field name="version" type="integer" column="version" version="true"/>
    </entity>
</doctrine-mapping>
