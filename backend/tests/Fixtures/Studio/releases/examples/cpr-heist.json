      "setup": [
        {"key": "first", "kind": "prompt", "title": "Who is your first crew member?", "mandatory": true},
        {"key": "second", "kind": "prompt", "title": "Who else is in?"}
      ],
      "play": [], "closing": []
    },
    {
      "key": "briefing", "name": "Briefing", "purpose": "Meet the client and hear the job.", "oracles": ["job-clients", "job-targets", "payouts"],
      "setup": [
