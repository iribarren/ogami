        {"key": "payout", "kind": "table", "title": "What does it pay?", "table": "payouts"},
        {"key": "plan", "kind": "prompt", "title": "What's the plan?"},
        {"key": "catch", "kind": "prompt", "title": "What's the catch?"}
      ],
      "play": [], "closing": []
    },
    {
      "key": "netrun", "name": "Netrun", "purpose": "Jack in and work the net architecture.", "tips": "Roll a floor for each level you go down; repeat floors in free play.", "oracles": ["net-floors", "black-ice"], "setup": [],
      "play": [
        {"key": "floor", "kind": "prompt", "title": "Which floor do you go for?"}
      ],
      "closing": []
    },
    {
      "key": "infiltration", "name": "Infiltration", "purpose": "Get inside unseen.", "oracles": ["fate", "complications"], "setup": [],
