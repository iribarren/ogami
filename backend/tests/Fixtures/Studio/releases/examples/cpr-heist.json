  "flows": [
    {
      "key": "heist", "name": "Heist", "description": "A one-shot heist for one sitting: set it up, do the legwork, pull the job, get away.",
      "introduction": "You play a crew pulling one job. Each step tells you what to decide or roll. Watch the alarm: when it fills, the job is over and you run.",
      "default": true, "defaultView": "focus", "oracles": ["fate", "job-clients", "job-targets", "payouts", "complications", "net-floors", "black-ice", "security-response", "npc-name"], "trackers": ["alarm", "edge", "objective"],
      "phases": [
        {"key": "the-job", "name": "The job", "mode": "once", "selection": {"rule": "sequence", "sceneTypes": ["crew", "briefing"]}},
        {
          "key": "legwork", "name": "Legwork", "mode": "loop", "selection": {"rule": "player", "sceneTypes": ["social", "exploration", "netrun"]},
          "sceneClosing": [
            {"key": "gain-edge", "kind": "choice", "title": "Did you gain an edge?", "options": [{"key": "yes", "label": "Yes", "effects": [{"kind": "tracker", "tracker": "edge", "op": "add", "value": 1}]}, {"key": "no", "label": "No"}], "skip": "no"}
          ],
          "worldTurn": [
            {"key": "word", "kind": "roll", "title": "Does word get around?", "dice": "1d6", "bands": [{"upTo": 1, "effects": [{"kind": "tracker", "tracker": "alarm", "op": "add", "value": 1}]}, {}]}
          ]
        },
        {
          "key": "the-heist", "name": "The heist", "mode": "loop", "selection": {"rule": "player", "sceneTypes": ["infiltration", "netrun", "grab"]},
          "sceneOpening": [
            {"key": "pressure", "kind": "condition", "title": "How alert is security?", "tracker": "alarm", "bands": [{"upTo": 3, "next": "end"}, {"upTo": 5}, {"next": "end"}]},
            {"key": "notice", "kind": "prompt", "title": "Security is on edge", "prompt": "The alarm is at {tracker:alarm}. What do you notice?"}
          ],
          "sceneClosing": [
            {"key": "edge-left", "kind": "condition", "title": "Do you have an edge?", "tracker": "edge", "bands": [{"upTo": 0, "next": "complication"}, {}]},
            {"key": "spend-edge", "kind": "choice", "title": "Spend an edge to avoid trouble?", "options": [{"key": "yes", "label": "Yes", "next": "lockdown", "effects": [{"kind": "tracker", "tracker": "edge", "op": "add", "value": -1}]}, {"key": "no", "label": "No", "next": "complication"}], "skip": "no"},
            {"key": "complication", "kind": "table", "title": "What goes wrong?", "table": "complications"},
            {"key": "lockdown", "kind": "condition", "title": "Is the alarm full?", "tracker": "alarm", "bands": [{"upTo": 5}, {"effects": [{"kind": "endPhase"}]}]}
          ],
          "worldTurn": [
            {"key": "response", "kind": "condition", "title": "Does security respond?", "tracker": "alarm", "bands": [{"upTo": 3, "next": "end"}, {}]},
            {"key": "guards", "kind": "roll", "title": "Do the guards find you?", "dice": "1d6", "bands": [{"upTo": 3, "effects": [{"kind": "nextScene", "sceneType": "firefight"}]}, {}]}
          ]
        },
        {"key": "escape", "name": "Escape", "mode": "once", "selection": {"rule": "sequence", "sceneTypes": ["getaway"]}},
        {"key": "epilogue", "name": "Epilogue", "mode": "once", "selection": {"rule": "sequence", "sceneTypes": ["payday"]}}
      ]
    }
  ],
