          {"text": "An ogre demanding a toll", "effects": [{"kind": "nextScene", "sceneType": "combat"}]},
          {"text": "Pilgrims on the wrong road", "effects": [{"kind": "nextScene", "sceneType": "encounter"}]}
        ]
      },
