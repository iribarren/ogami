          {"text": "An elf who knows your names", "effects": [{"kind": "nextScene", "sceneType": "encounter"}]},
          {"text": "The dead walking in the fog", "effects": [{"kind": "nextScene", "sceneType": "combat"}]},
          {"text": "A rival party, battered", "effects": [{"kind": "nextScene", "sceneType": "encounter"}]}
        ]
      },
      {
        "key": "site-features", "name": "Site features",
        "entries": [
          {"text": "A collapsed bridge"},
