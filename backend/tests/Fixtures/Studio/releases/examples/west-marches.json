        "entries": [
          {"text": "A cold night: a ration spoils", "effects": [{"kind": "tracker", "tracker": "rations", "op": "add", "value": -1}]},
          {"text": "You lose the trail: one more day out", "effects": [{"kind": "tracker", "tracker": "away", "op": "add", "value": 1}]},
          {"text": "Something follows you"},
          {"text": "A storm drenches your torches", "effects": [{"kind": "tracker", "tracker": "torches", "op": "add", "value": 1}]}
